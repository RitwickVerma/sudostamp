+// SudoStamp: time limits. Upstream sets none, so a peer that accepts the connection and then
+// goes quiet holds the caller (sudo) for as long as it likes, and the password prompt never
+// comes. All three fail the exchange, which falls through to the next PAM module.
+// CONNECT: a LAN peer that is there answers in milliseconds.
+const CONNECT_TIMEOUT: Duration = Duration::from_secs(5);
+// IDENTITIES: a phone answers REQUEST_IDENTITIES at once.
+const IDENTITIES_TIMEOUT: Duration = Duration::from_secs(10);
+// SIGN: must EXCEED the phone's approval window (AgentService.APPROVAL_TIMEOUT_MS = 60 s in
+// the SudoStamp app, after which it answers FAILURE itself), or a slow but honest approval
+// is cut off here first. 15 s of slack for the answer to cross the network.
+const SIGN_TIMEOUT: Duration = Duration::from_secs(75);
+
+// One deadline for a whole exchange. A per-read timeout bounds a single syscall, so a peer
+// sending one byte every 70 s would hold the connection for a day; this re-arms the timeout
+// with what is left before every read and write.
+struct Bounded<'s> {
+    stream: &'s mut Stream,
+    deadline: Instant,
+}
+
+impl Bounded<'_> {
+    fn left(&self) -> io::Result<Duration> {
+        let left = self.deadline.saturating_duration_since(Instant::now());
+        if left.is_zero() {
+            Err(io::ErrorKind::TimedOut.into())
+        } else {
+            Ok(left)
+        }
+    }
+}
+
+impl Read for Bounded<'_> {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        self.stream.set_read_timeout(Some(self.left()?))?;
+        self.stream.read(buf)
+    }
+}
+
+impl Write for Bounded<'_> {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        self.stream.set_write_timeout(Some(self.left()?))?;
+        self.stream.write(buf)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        self.stream.flush()
+    }
+}
+
+// A timeout is final: retrying a silent peer would multiply the wait.
+fn is_timeout(e: &(dyn std::error::Error + 'static)) -> bool {
+    e.downcast_ref::<io::Error>().map_or(false, |e| {
+        matches!(e.kind(), io::ErrorKind::TimedOut | io::ErrorKind::WouldBlock)
+    })
+}
