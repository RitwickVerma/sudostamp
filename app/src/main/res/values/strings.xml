    <!-- Onboarding (no key yet) -->
    <string name="onboard_title">Approve sudo with a touch</string>
    <string name="onboard_step1_title">Create a key</string>
    <string name="onboard_step1_body">It is made inside this phone\'s secure hardware and can never leave it.</string>
    <string name="onboard_step2_title">Pin it on your Linux host</string>
    <string name="onboard_step2_body">One command with tools/install.sh, or paste the public key into the pinned-keys file.</string>
    <string name="onboard_step3_title">Touch to approve</string>
    <string name="onboard_step3_body">Each sudo asks here. No touch, no signature — and your password still works.</string>
    <string name="onboard_create">Create key</string>
    <string name="onboard_footnote">The key needs your fingerprint for every single signature.</string>
    <string name="onboard_enroll">Set up a fingerprint first</string>
    <string name="onboard_enroll_hint">The key can only be created once a fingerprint is enrolled on this phone.</string>
    <string name="onboard_unsupported">This phone has no strong (Class 3) biometric sensor, so it cannot hold a SudoStamp key.</string>

