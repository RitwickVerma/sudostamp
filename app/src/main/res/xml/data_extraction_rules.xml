<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup, no device-to-device transfer, ever. The signing key never leaves
     the TEE regardless (it is non-exportable), but nothing else about this app should be
     captured either: exclude every domain explicitly so a future allowBackup change
     cannot silently start exporting state. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
